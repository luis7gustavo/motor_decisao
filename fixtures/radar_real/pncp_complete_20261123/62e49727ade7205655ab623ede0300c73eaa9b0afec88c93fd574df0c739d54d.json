 "},"anoCompra":2026,"dataAberturaProposta":"2026-06-05T09:29:46","dataAtualizacao":"2026-07-08T09:19:49","dataAtualizacaoGlobal":"2026-07-08T09:20:09","dataEncerramentoProposta":"2026-06-19T08:00:00","dataInclusao":"2026-07-08T09:19:49","dataPublicacaoPncp":"2026-07-08T09:19:49","emendaParlamentar":null,"existeResultado":true,"fontesOrcamentarias":[],"informacaoComplementar":"REGISTRO DE PREÇOS PARA FUTURA E EVENTUAL CONTRATAÇÃO DE EMPRESA ESPECIALIZADA PARA ELABORAÇÃO DE PROJETOS EXECUTIVOS, FORNECIMENTO, INSTALAÇÃO, HOMOLOGAÇÃO E COMISSIONAMENTO DE SISTEMAS FOTOVOLTAICOS.","justificativaPresencial":"A presente contratação tem por finalidade atender à necessidade do Município de Panamá de promover maior eficiência energética nas unidades vinculadas às Secretarias Municipais de Administração e Saúde, mediante a implantação de sistemas solares fotovoltaicos conectados à rede elétrica, incluindo a execução de estrutura tipo carport em uma das instalações, na modalidade de autoconsumo remoto.\nA adoção de geração de energia por fonte solar fotovoltaica representa medida estratégica e economicamente vantajosa para a Administração Pública, considerando o crescimento contínuo das despesas com energia elétrica e a necessidade de otimização dos recursos públicos. A implantação do sistema permitirá significativa redução dos custos operacionais relacionados ao consumo de energia elétrica das unidades atendidas, proporcionando economia contínua ao erário ao longo da vida útil dos equipamentos.\nAlém da redução de despesas, a contratação contribui para a modernização da infraestrutura pública municipal, promovendo maior sustentabilidade ambiental por meio da utilização de fonte limpa e renovável de energia, alinhando-se aos princípios da eficiência administrativa, economicidade e desenvolvimento sustentável previstos na legislação vigente.\nA execução do objeto contempla sistema com potência instalada total de 700 kWp e 540 kW de inversores, observando todas as normas técnicas e regulamentações aplicáveis, garantindo segurança, qualidade, desempenho e confiabilidade operacional. A inclusão de estrutura tipo carport agrega funcionalidade à instalação, proporcionando aproveitamento eficiente dos espaços públicos e proteção veicular, simultaneamente à geração de energia.\nDessa forma, a contratação mostra-se necessária e vantajosa para o Município, considerando os benefícios econômicos, ambientais e estruturais proporcionados pela implantação dos sistemas fotovoltaicos, assegurando maior eficiência na gestão dos recursos públicos e redução dos gastos com energia elétrica das unidades municipais\n","linkProcessoEletronico":null,"linkSistemaOrigem":"","modalidadeId":5,"modalidadeNome":"Concorrência - Presencial","modoDisputaId":1,"modoDisputaNome":"Aberto","numeroCompra":"8","numeroControlePNCP":"00079830000156-1-000002/2026","objetoCompra":"REGISTRO DE PREÇOS PARA FUTURA E EVENTUAL CONTRATAÇÃO DE EMPRESA ESPECIALIZADA PARA ELABORAÇÃO DE PROJETOS EXECUTIVOS, FORNECIMENTO, INSTALAÇÃO, HOMOLOGAÇÃO E COMISSIONAMENTO DE SISTEMAS FOTOVOLTAICOS. ","orcamentoSigilosoCodigo":1,"orcamentoSigilosoDescricao":"Compra sem sigilo","orgaoEntidade":{"cnpj":"00079830000156","esferaId":"M","poderId":"N","razaoSocial":"MUNICIPIO DE PANAMA"},"orgaoSubRogado":null,"processo":"8","sequencialCompra":2,"situacaoCompraId":1,"situacaoCompraNome":"Divulgada no PNCP","srp":true,"tipoInstrumentoConvocatorioCodigo":1,"tipoInstrumentoConvocatorioNome":"Edital","unidadeOrgao":{"codigoIbge":"5216007","codigoUnidade":"1","municipioNome":"Panamá","nomeUnidade":"MUNICIPIO DE PANAMA","ufNome":"Goiás","ufSigla":"GO"},"unidadeSubRogada":null,"usuarioNome":"CENTI","valorTotalEstimado":"4859250.00","valorTotalHomologado":"4850000.00"},"identity":"00079830000156-1-000002/2026","items":[{"description":"CONTRATAÇÃO DE EMPRESA ESPECIALIZADA PARA ELABORAÇÃO DE PROJETOS EXECUTIVOS, FORNECIMENTO, INSTALAÇÃO, HOMOLOGAÇÃO E COMISSIONAMENTO DE SISTEMAS FOTOVOLTAICOS CONECTADOS À REDE.","estim